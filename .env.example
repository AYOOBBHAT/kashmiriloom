# Server-only. Copy this file to .env.local and replace the placeholder.
# Do not commit .env.local. Do not prefix this name with NEXT_PUBLIC_.

MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.example.mongodb.net/kashmiriloom?retryWrites=true&w=majority
# Order creation uses a multi-document transaction. Atlas clusters are replica sets and support this.
# A standalone mongod does not. Do not point this at a database that cannot run transactions.

# First administrator. Used only by `pnpm admin:bootstrap`. There is no public registration page.
# Password must be 10 to 200 characters. Use a longer password when you can. Session secret must be at least 32 characters.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-long-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional image uploads. Leave blank to manage the existing local photographs only.
# Do not prefix these names with NEXT_PUBLIC_. The API secret must stay on the server.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay test checkout only. Live keys and RAZORPAY_MODE=live are rejected.
# The Key ID is sent to the browser so Standard Checkout can open. The Key Secret and webhook secret stay on the server.
# Do not prefix any of these names with NEXT_PUBLIC_.
# Webhook URL for the test dashboard: https://YOUR-PUBLIC-HOST/api/razorpay/webhook
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-the-test-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-the-test-webhook-secret

# Customer accounts. Do not prefix these names with NEXT_PUBLIC_.
# APP_URL is the canonical origin used for password-reset links and the Google callback.
# Local: http://localhost:3000
# Vercel: https://your-project.vercel.app
APP_URL=http://localhost:3000

# Google OAuth web client. Authorized JavaScript origin: the same origin as APP_URL.
# Authorized redirect URI: APP_URL + /auth/callback/google
# Example local redirect: http://localhost:3000/auth/callback/google
GOOGLE_CLIENT_ID=replace-with-the-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-the-google-client-secret

# Resend sends password-reset email only. The sender must be a verified Resend domain or address.
RESEND_API_KEY=replace-with-the-resend-api-key
EMAIL_FROM=KashmiriLoom <orders@example.com>

# Shared rate limits for registration, sign-in, password reset, and checkout submission.
# Create a Redis database at https://console.upstash.com and copy its REST URL and token.
# Do not prefix these names with NEXT_PUBLIC_.
# If the URL or token is missing, or Redis cannot be reached, those actions are refused.
# There is no in-memory fallback. Restart the app after adding the values.
# On Vercel, the platform sets VERCEL=1. The limiter then reads x-vercel-forwarded-for, then x-real-ip.
# It ignores X-Forwarded-For. Outside Vercel every visitor shares one address bucket named unknown.
# Optional limits, in attempts and milliseconds. Defaults are 5 auth attempts and 10 checkout submissions per 15 minutes.
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-the-upstash-rest-token
# AUTH_RATE_LIMIT_MAX=5
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# ORDER_RATE_LIMIT_MAX=10
# ORDER_RATE_LIMIT_WINDOW_MS=900000
